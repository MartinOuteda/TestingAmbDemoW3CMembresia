# ─────────────────────────────────────────────────────────────────────────────
# Configuración del ejemplo de verificación (front + BFF).
#
# TODA la configuración es de ejecución (runtime). La MISMA imagen Docker sirve para
# cualquier despliegue: solo cambia este archivo.
#   cp .env.example .env      # completa los valores
#   npm run dev               # o: docker run --env-file .env ...
#
# IMPORTANTE: en Docker todo lo que sigue a `=` es el valor; deja cada comentario en su
# propia línea. Nunca subas el `.env` real (contiene la clave de la cuenta de servicio).
# ─────────────────────────────────────────────────────────────────────────────

# ── 1) Verificación: QUÉ regla se ejecuta y contra qué backend ───────────────────

# Base del API de verificación de Blerify.
# Producción: https://api.blerify.com   ·   Staging: https://api.staging.blerify.com
# OJO con el orden de subdominios en staging: es api.staging.blerify.com, NO staging.api.blerify.com.
BLERIFY_API_URL=https://api.demo.blerify.com

# Organización verificadora. REQUERIDO.
ORG_ID=56aee7d4-c064-4293-b3fb-2f581fa92556

# Proyecto. REQUERIDO.
PROJECT_ID=da527a1d-2ad3-43ea-9366-b6a92625fe13

# Id de la regla de verificación (PresentationVerification publicada / ACTIVE). REQUERIDO.
RULE_ID=8ef0f12e-ebbe-49cd-936f-71fecfde95a1

# Base del deep link que abre la wallet al escanear el QR (o al pulsar el botón en móvil).
WALLET_BASE_URL=https://wallet.demo.blerify.com/

# ── 1b) Ruta de prueba /w3c: regla de tipo W3C con DCQL (opcional) ───────────────
# El sitio expone además una ruta /w3c INDEPENDIENTE del flujo principal, pensada para probar
# una regla de verificación de tipo W3C (JWT-VC, DCQL). Solo se activa si defines W3C_RULE_ID;
# el resto de valores caen a los del flujo por defecto (misma org/proyecto/wallet). La cuenta
# de servicio (sección 2) se reutiliza: sirve si la regla W3C está en la misma organización.
# Esta ruta NO tiene modo mock: siempre llama al backend real.

# Id de la PresentationVerification de tipo W3C. REQUERIDO para activar /w3c.
# W3C_RULE_ID=

# Opcional: organización de la regla W3C. Default = ORG_ID
# W3C_ORG_ID=

# Opcional: proyecto de la regla W3C. Default = PROJECT_ID
#W3C_PROJECT_ID=

# Opcional: base del deep link de la wallet para /w3c. Default = WALLET_BASE_URL
# W3C_WALLET_BASE_URL=

# ── 2) Cuenta de servicio: REQUERIDA para el flujo real (v2) ─────────────────────
# El BFF inicia y consulta la verificación con un token OAuth2 private_key_jwt (RFC 7523),
# aserción firmada RS256 (clave privada RSA-2048 en PKCS#8 PEM). Sin esto solo funciona DEMO_MOCK.

# client_id de la cuenta de servicio. REQUERIDO (v2).
SA_CLIENT_ID=membershipcredential-verifier-sa-1791331568

# Clave privada PKCS#8 PEM (RSA-2048), en UNA sola línea con \n literales. REQUERIDO (v2).
#   SA_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n
SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQDlaVI08H3kaI+m\nWedfcAj1V/l1qFRg3HtZHxdzjGXtkvkBz4pyO6ryhRu9yWnzlCYisZHvprbZO2/S\nhWekcVQL2IhFLCpInL6F/uzKUZvYb7UuEGYSX0l7COfSAiqvpHcIRR9UiUpyTUZt\n4NCLsOOcPI6oL+SfmSonjr/bRd6aEkKgYU7kMUI5FE2cC0iy0V2ovfa5GXUzbdE3\ncThaBqq4J7wRqeJ28vtHQgxL5V5CtwLvvcz9AC3S+tEmgXNo7o+NXoU8a/C++b8k\n5dgYsRmCyNYyB92zlKXsKHJHvso/x+InSvp0UCumvLrGN+AnUlNWdRd40tNKcQl0\nNEkirWN5AgMBAAECggEAF6xEWCOn7gmvJxyYYFQMjJqxKoe9+0fNL69iaWFHxFn5\n+Yqbz/lhxMhhCjbOSN0VCVf3BfqXXDfCrH/pJ8ItCNLljvPFgjwwed3KO/9rXEx8\nrv3wtn0gNULAPz7Lflfzk4Yke0H2jXB1b9G2229bsWvbUbYtep2gyLe1ixA87ft5\n4jvzuJmzSLzFYwso4newfWV6Mq3j8UV+JX8Ohu4kmYzWRpcBza4QOytZBm0NPEWH\n1GX9j1m+NNQCVy+m10eTa9MzcKufU9o7jXhcVPoSJOF3fYr+ykFVo3iW9iwypVtC\nCQTeVrWoYV3T44BdX1mUAePNTIo832PI6rvcAXvGnQKBgQDyLbGQzoaWd70m32tq\nUjaDY7JuZobd6luu99SmU9X4IWAYI6tdGqpH4+gTSGlHo2BeSM/eVYmML7l4dBPs\n3ueeCt4FIUMMmccGJOxVAZog4Z2UaobCwx1i+iz/TNlSkuq09Bw7wFBIcpXl7xOY\n5BrC+k0KdHVQuzyPmJ5sJnJ1LQKBgQDygRioYfJCDJLyd4T8Ou/bOOeMXfalIk9z\nm4YfMXrTLKEEOYDKoIMdDMaA4bc1+2ZZUw9vWxI4ayzcYCujjqOYqOQkY8McNWqe\nSTKmvulaIB55+7mb+b60zyqb3MSFpqP7jYacRYWFCjhUVMLwxDx7HYsBLx7V+euM\nHMKgYHeu/QKBgQCkJ/Lvi/5QqfNOES1XUUjgQMjm6ppKfBwPeq/q2nL0EXN4iV0T\n7Ao2Vrats2yhgY3F+ybjtylYG9VlX5FOAz4Os6EQ6x3uwaHVeVu0tzRJS4Ur4BVe\nmTEnMRslJms8/JcZd0pX+iCxKvKOfELVZPD67v0ftBb9VR1U3IeuGVWGNQKBgBtI\nNMr0wfl2Sq3mjlqGEuf53ernw1DOrFuYOp2Vxnitg6vjAD9LkZSaFFb5jdAP6XLR\nKmJfv4wDWresRhyPdo49KfWCF7g7tjP6ji0+Oyh9hpA4pqgKj87to6CHVMCof7hU\nMrmwBJZ0EORD6O6HVTqQl0vZzkFKbZqEvcynLa/NAoGAPydPVElbZZmjGwDEn5iw\nmGA8btmO9hDMrhjVzVyFbxJaqYpKuW+KS7VsdIbDe2lwpT0wftq1vvQetTWmXUyA\nqhpsJXcy85vz0UfgqNm2PJWWhDxqSZJNiJ5NdJFbN2AYLbR0R318IFMRgV6D52vc\n8zDasG620FIKZwhvypVLmqM=\n-----END PRIVATE KEY-----\n"

# Audiencia IAM, p.ej. https://iam.blerify.com/realms/{orgId}
# (staging: https://iam.staging.blerify.com/realms/{orgId}). REQUERIDO (v2).
SA_IAM_AUDIENCE=https://iam.demo.blerify.com/realms/56aee7d4-c064-4293-b3fb-2f581fa92556

# Opcional: endpoint del token. Default ${BLERIFY_API_URL}/auth/v2/protocol/openid-connect/token
# SA_TOKEN_URI=

# Opcional: organización de la cuenta de servicio. Default = ORG_ID
# SA_ORGANIZATION_ID=

# ── 3) Servicio ──────────────────────────────────────────────────────────────────

# Puerto de escucha.
PORT=8080

# ── 4) Modo demostración sin backend (opcional) ──────────────────────────────────
# DEMO_MOCK=true simula el flujo completo SIN llamar a Blerify ni requerir cuenta de servicio.
# Útil para probar la interfaz antes de tener una regla / credenciales reales.
# DEMO_MOCK=true

# Milisegundos que "tarda" la wallet simulada (solo en modo mock).
# DEMO_MOCK_DELAY_MS=5000
